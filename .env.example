# Microsoft Entra ID — MCP middle-tier app registration
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-me

# Application ID URI from Expose an API (defaults to api://{ENTRA_CLIENT_ID})
ENTRA_IDENTIFIER_URI=api://00000000-0000-0000-0000-000000000000

# Unprefixed scope name you created under Expose an API
ENTRA_MCP_SCOPE=access_as_user

# Public URL of this MCP server. Redirect URI in Entra must be {BASE_URL}/auth/callback
MCP_BASE_URL=http://127.0.0.1:8000

# bearer = clients send an Entra JWT whose aud is this app (best for learning OBO)
# proxy  = FastMCP AzureProvider OAuth proxy (better for Claude / Cursor style clients)
AUTH_MODE=bearer

# Downstream Graph scopes requested during OBO (space-separated)
GRAPH_SCOPES=https://graph.microsoft.com/User.Read https://graph.microsoft.com/Mail.Read
